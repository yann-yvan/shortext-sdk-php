{
    "name": "nycorp/shortext-php",
    "description": "PHP SDK for the Shortext API: AI agents on WhatsApp, mailboxes and your own apps.",
    "keywords": [
        "NyCorp",
        "Shortext",
        "whatsapp",
        "sdk",
        "laravel"
    ],
    "homepage": "https://github.com/nycorp/shortext-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Yvan Ngalle",
            "email": "nycorpdev@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^2.9||^3.0",
        "orchestra/testbench": "^10.0.0||^9.0.0||^8.22.0",
        "pestphp/pest": "^2.34||^3.0",
        "pestphp/pest-plugin-arch": "^2.7||^3.0",
        "phpseclib/phpseclib": "^4.0",
        "phpstan/extension-installer": "^1.3||^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.3||^2.0"
    },
    "suggest": {
        "illuminate/support": "Laravel integration: service provider, facade and config (^10.0|^11.0|^12.0)",
        "phpseclib/phpseclib": "Required by NyCorp\\Shortext\\Sdk\\Flows\\FlowCrypto (WhatsApp Flows encryption) (^4.0)"
    },
    "autoload": {
        "psr-4": {
            "NyCorp\\Shortext\\": "src/"
        },
        "files": [
            "src/autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "NyCorp\\Shortext\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NyCorp\\Shortext\\ShortextServiceProvider"
            ],
            "aliases": {
                "Shortext": "NyCorp\\Shortext\\Facades\\Shortext"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
